rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products collection: Allow public read for inventory lookup, restrict writes to store admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Scanner sessions collection: Allow creating pending session and updating pairing status
    match /scannerSessions/{sessionId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAuthenticated();
    }

    // Scanned products collection: Allow reading and recording scan events
    match /scannedProducts/{scanId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
  }
}
