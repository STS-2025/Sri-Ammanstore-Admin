rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS FOR ROLE & PERMISSION ENFORCEMENT
    // ==========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isValidStaffRole(role) {
      return role in [
        'super_admin',
        'store_manager',
        'inventory_staff',
        'delivery_manager',
        'packing_staff',
        'delivery_agent',
        'marketing_staff',
        'accounts_staff',
        'manual_staff'
      ];
    }

    function hasActiveStaffProfile() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().status == 'active' &&
        isValidStaffRole(getUserRole());
    }

    function isSuperAdmin() {
      return hasActiveStaffProfile() && getUserRole() == 'super_admin';
    }

    function isStoreManager() {
      return hasActiveStaffProfile() && (isSuperAdmin() || getUserRole() == 'store_manager');
    }

    function isInventoryStaff() {
      return hasActiveStaffProfile() && (isStoreManager() || getUserRole() == 'inventory_staff');
    }

    function isPackingStaff() {
      return hasActiveStaffProfile() && (isStoreManager() || getUserRole() == 'packing_staff');
    }

    function isDeliveryManager() {
      return hasActiveStaffProfile() && (isStoreManager() || getUserRole() == 'delivery_manager');
    }

    function isDeliveryAgent() {
      return hasActiveStaffProfile() && getUserRole() == 'delivery_agent';
    }

    function isMarketingStaff() {
      return hasActiveStaffProfile() && (isStoreManager() || getUserRole() == 'marketing_staff');
    }

    function isAccountsStaff() {
      return hasActiveStaffProfile() && (isStoreManager() || getUserRole() == 'accounts_staff');
    }

    function isManualStaff() {
      return hasActiveStaffProfile() && getUserRole() == 'manual_staff';
    }

    // ==========================================================
    // USERS & ROLES
    // ==========================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isStoreManager());
      allow create: if isSuperAdmin() &&
        request.resource.data.uid == userId &&
        isValidStaffRole(request.resource.data.role) &&
        request.resource.data.status == 'active';
      allow update: if (
          isSuperAdmin() &&
          userId != request.auth.uid &&
          request.resource.data.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isValidStaffRole(request.resource.data.role)) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['active', 'disabled'])
        ) || (
          request.auth.uid == userId &&
          request.resource.data.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email', 'role', 'permissions', 'status', 'delegatedPermissions'])
        );
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ==========================================================
    // PRODUCT CATALOG & CATEGORIES (Public read for customer store, admin write)
    // ==========================================================
    match /products/{productId} {
      allow read: if true; // Public for e-commerce website
      allow create, update: if isInventoryStaff() || isStoreManager();
      allow delete: if isSuperAdmin(); // Destructive action requires Super Admin
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow create, update: if isInventoryStaff() || isStoreManager();
      allow delete: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isStoreManager();
      allow delete: if isSuperAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow create, update: if isStoreManager();
      allow delete: if isSuperAdmin();
    }

    // ==========================================================
    // INVENTORY & BATCHES
    // ==========================================================
    match /inventory/{inventoryId} {
      allow read: if isInventoryStaff() || isPackingStaff() || isDeliveryManager();
      allow write: if isInventoryStaff();
    }

    match /stockMovements/{movementId} {
      allow read: if isInventoryStaff() || isAccountsStaff();
      allow create: if isInventoryStaff();
      allow update, delete: if isSuperAdmin();
    }

    match /batches/{batchId} {
      allow read: if isInventoryStaff() || isPackingStaff();
      allow write: if isInventoryStaff();
    }

    // ==========================================================
    // CUSTOMERS & ADDRESSES
    // ==========================================================
    match /customers/{customerId} {
      allow read: if isStoreManager() || isAccountsStaff() || isManualStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow create: if isAuthenticated();
      allow update: if isStoreManager() || isManualStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow delete: if isSuperAdmin() || isManualStaff();
    }

    match /onlineCustomers/{customerId} {
      allow read: if isStoreManager() || isAccountsStaff() || isManualStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow create: if isAuthenticated();
      allow update: if isStoreManager() || isManualStaff() || (isAuthenticated() && request.auth.uid == customerId);
      allow delete: if isSuperAdmin() || isManualStaff();
    }

    match /addresses/{addressId} {
      allow read: if isStoreManager() || isDeliveryAgent() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isStoreManager() || (isAuthenticated() && request.resource.data.customerId == request.auth.uid);
    }

    // ==========================================================
    // ORDERS & FULFILLMENT
    // ==========================================================
    match /orders/{orderId} {
      // Delivery agent can ONLY read orders assigned to them
      allow read: if isStoreManager() || isPackingStaff() || isAccountsStaff() ||
                     (isManualStaff() && resource.data.orderSource == 'manual') ||
                     (isDeliveryAgent() && resource.data.deliveryAgentId == request.auth.uid) ||
                     (isAuthenticated() && resource.data.customerId == request.auth.uid);
      
      allow create: if isAuthenticated(); // Customer app or staff
      allow update: if isStoreManager() ||
                       (isManualStaff() && resource.data.orderSource == 'manual' && request.resource.data.orderSource == 'manual') ||
                       (isPackingStaff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'packedAt', 'packedBy', 'packingNotes'])) ||
                       (isDeliveryAgent() && resource.data.deliveryAgentId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deliveryNotes', 'deliveredAt', 'proofOfDeliveryUrl', 'codAmountCollected']));
      allow delete: if isSuperAdmin() || (isManualStaff() && resource.data.orderSource == 'manual');
    }

    match /orderItems/{itemId} {
      allow read: if isAuthenticated();
      allow write: if isStoreManager() || isPackingStaff();
    }

    match /orderStatusHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // DELIVERY & LOGISTICS
    // ==========================================================
    match /deliveryAgents/{agentId} {
      allow read: if isDeliveryManager() || (isDeliveryAgent() && request.auth.uid == agentId);
      allow write: if isDeliveryManager();
    }

    match /deliveryBatches/{batchId} {
      allow read: if isDeliveryManager() || (isDeliveryAgent() && resource.data.agentId == request.auth.uid);
      allow write: if isDeliveryManager();
    }

    match /deliveryStops/{stopId} {
      allow read: if isDeliveryManager() || (isDeliveryAgent() && resource.data.agentId == request.auth.uid);
      allow write: if isDeliveryManager() || (isDeliveryAgent() && resource.data.agentId == request.auth.uid);
    }

    // ==========================================================
    // PAYMENTS, COD & FINANCIALS (Restricted to Accounts & Super Admin)
    // ==========================================================
    match /payments/{paymentId} {
      allow read: if isAccountsStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAccountsStaff();
    }

    match /codCollections/{collectionId} {
      allow read: if isAccountsStaff() || isDeliveryManager() || (isDeliveryAgent() && resource.data.agentId == request.auth.uid);
      allow create: if isDeliveryAgent() || isAccountsStaff();
      allow update: if isAccountsStaff(); // Reconciliations
      allow delete: if isSuperAdmin();
    }

    match /returns/{returnId} {
      allow read: if isStoreManager() || isAccountsStaff();
      allow write: if isStoreManager();
    }

    match /refunds/{refundId} {
      allow read: if isAccountsStaff();
      allow write: if isAccountsStaff(); // High risk
    }

    // ==========================================================
    // MARKETING & PROMOTIONS
    // ==========================================================
    match /promoCodes/{codeId} {
      allow read: if true; // Public for validation
      allow write: if isMarketingStaff();
    }

    match /promoUsage/{usageId} {
      allow read: if isMarketingStaff() || isAccountsStaff();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isMarketingStaff();
    }

    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isMarketingStaff();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isMarketingStaff();
    }

    match /campaigns/{campaignId} {
      allow read: if isMarketingStaff();
      allow write: if isMarketingStaff();
    }

    match /notificationTemplates/{templateId} {
      allow read: if isMarketingStaff();
      allow write: if isMarketingStaff();
    }

    match /notificationLogs/{logId} {
      allow read: if isMarketingStaff();
      allow write: if isMarketingStaff();
    }

    // ==========================================================
    // CUSTOMER REQUESTS & LOYALTY
    // ==========================================================
    match /productRequests/{requestId} {
      allow read: if isStoreManager() || isMarketingStaff();
      allow create: if isAuthenticated();
      allow update: if isStoreManager() || isMarketingStaff();
      allow delete: if isSuperAdmin();
    }

    // Pair mobile barcode scanners with a short-lived POS session.
    match /scannerSessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if hasActiveStaffProfile() &&
        request.resource.data.status == 'WAITING_FOR_MOBILE' &&
        request.resource.data.token is string &&
        request.resource.data.token.size() >= 16;
      allow update: if hasActiveStaffProfile() ||
        (
          isAuthenticated() &&
          request.resource.data.verifiedToken == resource.data.token &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'verifiedToken',
            'connectedDeviceId',
            'connectedDeviceName',
            'connectedAt',
            'lastActivityAt',
            'disconnectedAt'
          ]) &&
          request.resource.data.status in ['CONNECTED', 'DISCONNECTED']
        );
      allow delete: if hasActiveStaffProfile();

      match /scanEvents/{eventId} {
        function parentSession() {
          return get(/databases/$(database)/documents/scannerSessions/$(sessionId)).data;
        }

        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          parentSession().status == 'CONNECTED' &&
          request.resource.data.token == parentSession().token &&
          request.resource.data.eventId == eventId &&
          request.resource.data.sessionId == sessionId &&
          request.resource.data.type == 'BARCODE_SCANNED' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.barcode is string &&
          request.resource.data.barcode.size() > 0 &&
          request.resource.data.keys().hasOnly([
            'scanId',
            'sessionId',
            'adminUid',
            'storeId',
            'scannerId',
            'productId',
            'barcode',
            'productNameSnapshot',
            'price',
            'stock',
            'quantity',
            'scannedAt',
            'imageUrl',
            'eventId',
            'type',
            'deviceId',
            'status',
            'result',
            'token',
            'createdAt',
            'serverTimestamp'
          ]);
        allow update: if hasActiveStaffProfile() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'result',
            'processedAt'
          ]) &&
          request.resource.data.status in ['processed', 'failed'];
        allow delete: if hasActiveStaffProfile();
      }
    }

    match /smartCoinTransactions/{txId} {
      allow read: if isAccountsStaff() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAccountsStaff();
    }

    match /customerLedger/{ledgerId} {
      allow read: if isStoreManager() || isAccountsStaff() || isManualStaff();
      allow create: if isStoreManager() || isAccountsStaff() || isManualStaff();
      allow update, delete: if isSuperAdmin();
    }

    // ==========================================================
    // AUDIT LOGS & SETTINGS
    // ==========================================================
    match /activityLogs/{logId} {
      allow read: if isSuperAdmin() || isStoreManager();
      allow create: if isAuthenticated(); // All staff actions logged
      allow update, delete: if false; // Immutable audit trail
    }

    match /businessSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin(); // Financial/owner settings strictly Super Admin
    }
  }
}
